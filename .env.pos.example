# Copy these values into Desk's ROOT .env (used by Docker Compose).
# Set the actual absolute Ubuntu paths for the existing FTP deployment.
POS_FTP_DATA_DIR=/opt/ftp/data
POS_FTP_ARCHIVE_DIR=/opt/ftp/archive

# Locations and timezones are read from https://app.gen7fuel.com/api/locations.
# No Hub MongoDB connection or locations-specific environment setting is needed.
# Optional backend settings:
# POS_SCAN_SECONDS=60
# POS_FILE_STABLE_SECONDS=30
